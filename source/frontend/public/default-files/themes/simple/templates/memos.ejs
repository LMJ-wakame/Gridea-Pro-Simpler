<%
  var memoPassword = site.customConfig.memosPassword || ''; 

  var protectedMemos = (memos || []).map(function(memo) {
    var memoImages = [];

    if (memo.images && memo.images.length) {
      memo.images.forEach(function(image) {
        var src = '';
        if (typeof image === 'string') src = image;
        else if (image) src = image.url || image.src || image.path || '';
        if (src) memoImages.push(src);
      });
    }

    return {
      content: memo.content || '',
      images: memoImages,
      createdAtISO: memo.createdAtISO || '',
      date: memo.dateFormat || memo.createdAt || '',
      tags: memo.tags || []
    };
  });

  function hash32(str, seed) {
    var h = (2166136261 ^ seed) >>> 0;
    for (var i = 0; i < str.length; i++) {
      h ^= str.charCodeAt(i);
      h = Math.imul(h, 16777619) >>> 0;
      h ^= h >>> 13;
    }
    h ^= h >>> 16;
    h = Math.imul(h, 2246822507) >>> 0;
    h ^= h >>> 13;
    h = Math.imul(h, 3266489909) >>> 0;
    h ^= h >>> 16;
    return h >>> 0;
  }

  function makeKey(password) {
    return [
      hash32(password, 0x243f6a88),
      hash32(password, 0x85a308d3),
      hash32(password, 0x13198a2e),
      hash32(password, 0x03707344)
    ];
  }

  function xteaBlock(v0, v1, key) {
    var sum = 0;
    var delta = 0x9e3779b9;
    for (var i = 0; i < 32; i++) {
      v0 = (v0 + (((((v1 << 4) ^ (v1 >>> 5)) + v1) >>> 0) ^ ((sum + key[sum & 3]) >>> 0))) >>> 0;
      sum = (sum + delta) >>> 0;
      v1 = (v1 + (((((v0 << 4) ^ (v0 >>> 5)) + v0) >>> 0) ^ ((sum + key[(sum >>> 11) & 3]) >>> 0))) >>> 0;
    }
    return [v0 >>> 0, v1 >>> 0];
  }

  function encryptText(text, password) {
    var binary = unescape(encodeURIComponent(text));
    var key = makeKey(password);
    var out = '';

    for (var base = 0, counter = 0; base < binary.length; base += 8, counter++) {
      var block = xteaBlock(counter >>> 0, (0xa5a5a5a5 ^ counter) >>> 0, key);
      var stream = [
        block[0] & 255,
        (block[0] >>> 8) & 255,
        (block[0] >>> 16) & 255,
        (block[0] >>> 24) & 255,
        block[1] & 255,
        (block[1] >>> 8) & 255,
        (block[1] >>> 16) & 255,
        (block[1] >>> 24) & 255
      ];

      for (var j = 0; j < 8 && base + j < binary.length; j++) {
        var b = binary.charCodeAt(base + j) ^ stream[j];
        out += ('0' + b.toString(16)).slice(-2);
      }
    }
    return out;
  }

  var memoEncryptedHex = encryptText(JSON.stringify(protectedMemos), memoPassword);
%>
<!DOCTYPE html>
<html>
  <head>
    <%- include('./_blocks/head', {
      siteTitle: `Memos | ${themeConfig.siteName}`
    }) %>

    <meta
      name="description"
      content="All my dreams fit between two blinks."
    >
    <meta name="robots" content="noindex,nofollow,noarchive,nosnippet">

    <style>
      .memos-container {
        max-width: 760px;
      }

      .memos-header {
        margin-bottom: 56px;
      }

      .memos-title {
        margin: 0 0 14px;
        font-size: 32px;
        font-weight: 600;
        line-height: 1.25;
        color: #343a40;
      }

      .memos-description {
        margin: 0;
        max-width: 520px;
        font-size: 14px;
        line-height: 1.8;
        color: #868e96;
      }

      .memos-lock {
        max-width: 420px;
        padding-top: 2px;
      }

      .memos-lock-label {
        display: block;
        margin-bottom: 10px;
        font-size: 13px;
        color: #868e96;
      }

      .memos-lock-row {
        display: flex;
        gap: 10px;
      }

      .memos-password {
        min-width: 0;
        flex: 1;
        box-sizing: border-box;
        height: 42px;
        padding: 0 12px;
        border: 1px solid rgba(0, 0, 0, .14);
        border-radius: 3px;
        outline: none;
        background: transparent;
        color: #343a40;
        font: inherit;
        font-size: 14px;
        transition: border-color .15s ease;
      }

      .memos-password:focus {
        border-color: #868e96;
      }

      .memos-unlock {
        height: 42px;
        padding: 0 18px;
        border: 1px solid #343a40;
        border-radius: 3px;
        background: #343a40;
        color: #fff;
        font: inherit;
        font-size: 13px;
        cursor: pointer;
      }

      .memos-unlock:disabled {
        opacity: .55;
        cursor: default;
      }

      .memos-lock-status {
        min-height: 20px;
        margin: 10px 0 0;
        font-size: 12px;
        line-height: 1.6;
        color: #adb5bd;
      }

      .memos-lock-status.error {
        color: #868e96;
      }

      .memos-content-root[hidden] {
        display: none;
      }

      .memos-list {
        border-top: 1px solid rgba(0, 0, 0, .08);
      }

      .memo-item {
        padding: 32px 0 28px;
        border-bottom: 1px solid rgba(0, 0, 0, .08);
      }

      .memo-content {
        font-size: 16px;
        line-height: 1.9;
        color: #343a40;
        word-break: break-word;
      }

      .memo-content > :first-child {
        margin-top: 0;
      }

      .memo-content > :last-child {
        margin-bottom: 0;
      }

      .memo-content p {
        margin: 0 0 14px;
      }

      .memo-content a {
        color: inherit;
        text-decoration: underline;
        text-decoration-color: #adb5bd;
        text-underline-offset: 3px;
      }

      .memo-content blockquote {
        margin: 18px 0;
        padding-left: 16px;
        border-left: 2px solid #ced4da;
        color: #6c757d;
      }

      .memo-content code {
        padding: 2px 5px;
        border-radius: 3px;
        background: rgba(0, 0, 0, .05);
        font-size: .9em;
      }

      .memo-content img {
        display: block;
        max-width: 100%;
        height: auto;
        margin: 20px 0 6px;
        border-radius: 3px;
      }

      .memo-images {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
        margin-top: 20px;
      }

      .memo-images.single {
        display: block;
      }

      .memo-image {
        width: 100%;
        height: auto;
        display: block;
        border-radius: 3px;
        object-fit: cover;
      }

      .memo-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 18px;
        font-size: 12px;
        color: #adb5bd;
      }

      .memo-date {
        color: #adb5bd;
      }

      .memo-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .memo-tag {
        color: #868e96;
      }

      .memo-tag::before {
        content: "#";
        margin-right: 1px;
        color: #adb5bd;
      }

      .memos-empty {
        padding: 40px 0;
        border-top: 1px solid rgba(0, 0, 0, .08);
        font-size: 14px;
        color: #adb5bd;
      }

      @media (max-width: 768px) {
        .memos-header {
          margin-bottom: 38px;
        }

        .memos-title {
          font-size: 28px;
        }

        .memos-lock-row {
          display: block;
        }

        .memos-password,
        .memos-unlock {
          width: 100%;
        }

        .memos-unlock {
          margin-top: 10px;
        }

        .memo-item {
          padding: 26px 0 23px;
        }

        .memo-content {
          font-size: 15px;
          line-height: 1.85;
        }

        .memo-images {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>

  <body>
    <div id="app" class="main">

      <%- include('./_blocks/sidebar') %>

      <div class="main-container">

        <div
          class="content-container memos-container"
          data-aos="fade-up"
        >

          <header class="memos-header">
            <h1 class="memos-title">Memos</h1>
            <p class="memos-description">
              All my dreams fit between two blinks.
            </p>
          </header>

          <section id="memos-lock" class="memos-lock">
            <label class="memos-lock-label" for="memos-password">
              This page is private.
            </label>

            <form id="memos-unlock-form" class="memos-lock-row">
              <input
                id="memos-password"
                class="memos-password"
                type="password"
                placeholder="Password"
                autocomplete="current-password"
                spellcheck="false"
                autofocus
              >
              <button
                id="memos-unlock-button"
                class="memos-unlock"
                type="submit"
              >
                Unlock
              </button>
            </form>

            <p
              id="memos-lock-status"
              class="memos-lock-status"
              aria-live="polite"
            ></p>
          </section>

          <div id="memos-content-root" class="memos-content-root" hidden></div>

        </div>

      </div>

    </div>

    <%- include('./_blocks/scripts') %>

    <script>
      (function() {
        const encryptedPayload = <%- JSON.stringify(memoEncryptedHex) %>;

        const lock = document.getElementById('memos-lock');
        const form = document.getElementById('memos-unlock-form');
        const input = document.getElementById('memos-password');
        const button = document.getElementById('memos-unlock-button');
        const status = document.getElementById('memos-lock-status');
        const root = document.getElementById('memos-content-root');

        function hash32(str, seed) {
          let h = (2166136261 ^ seed) >>> 0;
          for (let i = 0; i < str.length; i++) {
            h ^= str.charCodeAt(i);
            h = Math.imul(h, 16777619) >>> 0;
            h ^= h >>> 13;
          }
          h ^= h >>> 16;
          h = Math.imul(h, 2246822507) >>> 0;
          h ^= h >>> 13;
          h = Math.imul(h, 3266489909) >>> 0;
          h ^= h >>> 16;
          return h >>> 0;
        }

        function makeKey(password) {
          return [
            hash32(password, 0x243f6a88),
            hash32(password, 0x85a308d3),
            hash32(password, 0x13198a2e),
            hash32(password, 0x03707344)
          ];
        }

        function xteaBlock(v0, v1, key) {
          let sum = 0;
          const delta = 0x9e3779b9;
          for (let i = 0; i < 32; i++) {
            v0 = (v0 + (((((v1 << 4) ^ (v1 >>> 5)) + v1) >>> 0) ^ ((sum + key[sum & 3]) >>> 0))) >>> 0;
            sum = (sum + delta) >>> 0;
            v1 = (v1 + (((((v0 << 4) ^ (v0 >>> 5)) + v0) >>> 0) ^ ((sum + key[(sum >>> 11) & 3]) >>> 0))) >>> 0;
          }
          return [v0 >>> 0, v1 >>> 0];
        }

        function decryptMemos(password) {
          const key = makeKey(password);
          const bytes = new Uint8Array(encryptedPayload.length / 2);

          for (let i = 0; i < bytes.length; i++) {
            bytes[i] = parseInt(encryptedPayload.slice(i * 2, i * 2 + 2), 16);
          }

          for (let base = 0, counter = 0; base < bytes.length; base += 8, counter++) {
            const block = xteaBlock(counter >>> 0, (0xa5a5a5a5 ^ counter) >>> 0, key);
            const stream = [
              block[0] & 255,
              (block[0] >>> 8) & 255,
              (block[0] >>> 16) & 255,
              (block[0] >>> 24) & 255,
              block[1] & 255,
              (block[1] >>> 8) & 255,
              (block[1] >>> 16) & 255,
              (block[1] >>> 24) & 255
            ];

            for (let j = 0; j < 8 && base + j < bytes.length; j++) {
              bytes[base + j] ^= stream[j];
            }
          }

          return JSON.parse(new TextDecoder().decode(bytes));
        }

        function renderMemos(memos) {
          root.innerHTML = '';

          if (!memos || memos.length === 0) {
            const empty = document.createElement('div');
            empty.className = 'memos-empty';
            empty.textContent = 'No Memos...';
            root.appendChild(empty);
            return;
          }

          const list = document.createElement('section');
          list.className = 'memos-list';

          memos.forEach(function(memo) {
            const article = document.createElement('article');
            article.className = 'memo-item';

            const content = document.createElement('div');
            content.className = 'memo-content';
            content.innerHTML = memo.content || '';
            article.appendChild(content);

            if (memo.images && memo.images.length) {
              const images = document.createElement('div');
              images.className = 'memo-images' + (memo.images.length === 1 ? ' single' : '');

              memo.images.forEach(function(src) {
                const image = document.createElement('img');
                image.className = 'memo-image';
                image.src = src;
                image.alt = '';
                image.loading = 'lazy';
                images.appendChild(image);
              });

              article.appendChild(images);
            }

            const footer = document.createElement('footer');
            footer.className = 'memo-meta';

            const time = document.createElement('time');
            time.className = 'memo-date';
            time.dateTime = memo.createdAtISO || '';
            time.textContent = memo.date || '';
            footer.appendChild(time);

            if (memo.tags && memo.tags.length) {
              const tags = document.createElement('div');
              tags.className = 'memo-tags';

              memo.tags.forEach(function(tag) {
                const item = document.createElement('span');
                item.className = 'memo-tag';
                item.textContent = tag;
                tags.appendChild(item);
              });

              footer.appendChild(tags);
            }

            article.appendChild(footer);
            list.appendChild(article);
          });

          root.appendChild(list);
        }

        form.addEventListener('submit', async function(event) {
          event.preventDefault();

          const password = input.value;
          if (!password) {
            status.textContent = 'Enter the password.';
            status.classList.add('error');
            input.focus();
            return;
          }

          button.disabled = true;
          input.disabled = true;
          status.textContent = 'Unlocking...';
          status.classList.remove('error');

          try {
            const memos = await decryptMemos(password);
            renderMemos(memos);

            input.value = '';
            lock.hidden = true;
            root.hidden = false;
          } catch (error) {
            status.textContent = 'Incorrect password.';
            status.classList.add('error');
            input.select();
          } finally {
            button.disabled = false;
            input.disabled = false;
          }
        });
      })();
    </script>

  </body>
</html>
